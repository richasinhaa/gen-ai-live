# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in real values.
# Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/genai_live?schema=public"

# Public base URL, used to build absolute links in confirmations.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Razorpay ---------------------------------------------------------------
# Dashboard > Settings > API Keys. The key id is safe to expose to the browser;
# the secret and webhook secret must stay server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Dashboard > Settings > Webhooks. Point the webhook at
# <site>/api/webhooks/razorpay and subscribe to payment.captured and
# payment.failed.
RAZORPAY_WEBHOOK_SECRET=""

# --- Admin ------------------------------------------------------------------
# Password for /admin. Use a long random string in production.
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=""

# --- Contact / social -------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your_handle"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/your-page"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
